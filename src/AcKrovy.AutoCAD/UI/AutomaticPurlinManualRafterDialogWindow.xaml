<Window x:Class="AcKrovy.AutoCAD.UI.AutomaticPurlinManualRafterDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="320"
        MinWidth="380"
        MinHeight="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WoodOakBrush}"
        Foreground="{DynamicResource SettingsTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
                <ResourceDictionary Source="Design/RoofGeometryVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsPrimaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsBaseButtonStyle}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource RoofGeometryPrimaryButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RoofGeometryPrimaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SettingsSecondaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsBaseButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource RoofGeometrySecondaryButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RoofGeometrySecondaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            Padding="14"
            Background="{DynamicResource SettingsPanelBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Margin="0,0,10,0"
                        MinWidth="96"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Style="{StaticResource SettingsSecondaryButtonStyle}" />
                <Button x:Name="ConfirmButton"
                        MinWidth="96"
                        IsDefault="True"
                        Click="ConfirmButton_Click"
                        Style="{StaticResource SettingsPrimaryButtonStyle}" />
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="DescriptionText"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Style="{DynamicResource SettingsDescriptionStyle}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="WidthLabel" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthTextBox"
                                     MinHeight="28"
                                     Padding="6,4"
                                     TextAlignment="Right" />
                            <TextBlock x:Name="UnitWidthText"
                                       Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="HeightLabel" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HeightTextBox"
                                     MinHeight="28"
                                     Padding="6,4"
                                     TextAlignment="Right" />
                            <TextBlock x:Name="UnitHeightText"
                                       Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <Button x:Name="SelectFromDrawingButton"
                        Margin="0,4,0,8"
                        HorizontalAlignment="Stretch"
                        MinHeight="30"
                        Click="SelectFromDrawingButton_Click"
                        Style="{StaticResource SettingsSecondaryButtonStyle}" />
                <TextBlock x:Name="ValidationText"
                           Foreground="{DynamicResource SettingsValidationBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
