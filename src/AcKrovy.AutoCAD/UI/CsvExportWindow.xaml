<Window x:Class="AcKrovy.AutoCAD.UI.CsvExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
        Title="{localization:Loc CsvExportWindow_Title}"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18"
            Style="{DynamicResource SettingsCardStyle}">
        <StackPanel>
            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                       Text="{localization:Loc CsvExportWindow_Heading}" />
            <TextBlock Margin="0,4,0,14"
                       Style="{DynamicResource SettingsDescriptionStyle}"
                       Text="{localization:Loc CsvExportWindow_Description}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{localization:Loc CsvExportWindow_Source}" />
            <RadioButton x:Name="PickFirstRadio"
                         Margin="0,8,0,2"
                         GroupName="Source" />
            <RadioButton x:Name="ManualSelectionRadio"
                         Margin="0,4"
                         GroupName="Source"
                         Content="{localization:Loc CsvExportWindow_ManualSelection}" />
            <RadioButton x:Name="ModelSpaceRadio"
                         Margin="0,4,0,14"
                         GroupName="Source"
                         Content="{localization:Loc CsvExportWindow_ModelSpace}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{localization:Loc CsvExportWindow_Mode}" />
            <RadioButton x:Name="IndividualRadio"
                         Margin="0,8,0,2"
                         GroupName="Mode"
                         IsChecked="True"
                         Content="{localization:Loc CsvExportWindow_Individual}" />
            <RadioButton x:Name="SummarizedRadio"
                         Margin="0,4,0,0"
                         GroupName="Mode"
                         Content="{localization:Loc CsvExportWindow_Summarized}" />
            <StackPanel Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="100"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SettingsSecondaryButtonStyle}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="{localization:Loc Common_Cancel}" />
                <Button MinWidth="100"
                        Style="{DynamicResource SettingsPrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Confirm_Click"
                        Content="{localization:Loc CsvExportWindow_Continue}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
