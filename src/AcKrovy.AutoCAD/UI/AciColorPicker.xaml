<UserControl x:Class="AcKrovy.AutoCAD.UI.AciColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             x:Name="PickerRoot"
             Focusable="False">
    <Button x:Name="OpenButton"
            Style="{DynamicResource SettingsSecondaryButtonStyle}"
            HorizontalContentAlignment="Stretch"
            Click="OpenButton_Click"
            automation:AutomationProperties.Name="{localization:Loc SettingsWindow_AciPicker_Open}">
        <Grid MinWidth="118">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="22"
                    Height="22"
                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="{Binding SelectedColor.Brush, ElementName=PickerRoot}" />
            <TextBlock Grid.Column="1"
                       Margin="9,0,8,0"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedColor.TechnicalLabel, ElementName=PickerRoot}" />
            <Path Grid.Column="2"
                  Width="9"
                  Height="5"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource SettingsTextSecondaryBrush}"
                  Data="M0,0 L9,0 4.5,5 Z" />
        </Grid>
    </Button>
</UserControl>
