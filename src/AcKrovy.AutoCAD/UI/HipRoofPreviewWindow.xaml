<Window x:Class="AcKrovy.AutoCAD.UI.HipRoofPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
        Title="{Binding WindowTitle}"
        Width="520"
        MinWidth="460"
        MinHeight="300"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WoodOakBrush}"
        Foreground="{DynamicResource SettingsTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
                <ResourceDictionary Source="Design/RoofGeometryVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <!--
              Explicit numeric-field template matching the proven Settings TextBox metrics.
              The default TextBox ScrollViewer host clips glyphs when a Star-sized parent
              compresses ActualHeight below MinHeight+padding; this template keeps a fixed
              control height and centers the content host.
            -->
            <Style x:Key="HipSlopeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="MinHeight" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="MaxHeight" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontFamily" Value="{DynamicResource SettingsFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource SettingsFontSizeBody}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource SettingsCornerRadiusSmall}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="{DynamicResource SettingsDisabledOpacity}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsFocusBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#B8860B" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsValidationBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBand" Height="86" Padding="18,14"
                Background="{StaticResource WoodOakDarkBrush}"
                BorderBrush="#321708" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center"
                        Background="#2AFFFFFF" BorderBrush="#88FFF4DF" BorderThickness="1" CornerRadius="8">
                    <Viewbox Width="26" Height="26" Margin="7">
                        <Path Data="{StaticResource RoofGeometryGableIconGeometry}"
                              Stroke="{StaticResource RoofGeometryHeaderTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource RoofGeometryHeaderTextBrush}"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Margin="0,3,0,0" Style="{DynamicResource SettingsDescriptionStyle}"
                               Foreground="{StaticResource RoofGeometryHeaderSecondaryTextBrush}"
                               Text="{Binding WindowDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="14"
                Style="{DynamicResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Margin="0,0,0,10"
                           Style="{DynamicResource SettingsSectionTitleStyle}"
                           Text="{localization:Loc RoofGeometryWindow_EnteredValues}" />
                <TextBlock Margin="0,0,0,5"
                           Text="{localization:Loc RoofGeometryWindow_MonopitchSlope}" />
                <TextBox x:Name="SlopeTextBox"
                         Style="{StaticResource HipSlopeTextBoxStyle}"
                         Text="{Binding SlopeText, UpdateSourceTrigger=PropertyChanged}" />
                <Border x:Name="ValidationPanel"
                        Margin="0,8,0,0"
                        Padding="10,8"
                        Background="#33B8860B"
                        BorderBrush="#B8860B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox x:Name="ValidationIcon"
                                 Width="16"
                                 Height="16"
                                 Margin="0,1,8,0"
                                 VerticalAlignment="Top"
                                 Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,2.8 L22.2,20.8 L1.8,20.8 Z"
                                      Fill="#C9A227"
                                      Stroke="#8A6A12"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round" />
                                <Ellipse Canvas.Left="10.4" Canvas.Top="8.2" Width="3.2" Height="3.2" Fill="#5C4310" />
                                <Rectangle Canvas.Left="11" Canvas.Top="12.2" Width="2" Height="5.6" Fill="#5C4310" RadiusX="0.6" RadiusY="0.6" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ValidationTextBlock"
                                   Grid.Column="1"
                                   FontFamily="{DynamicResource SettingsFontFamily}"
                                   FontSize="{DynamicResource SettingsFontSizeBody}"
                                   Foreground="#6B4A12"
                                   Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="FooterBand" Grid.Row="2" Grid.RowSpan="2" Height="86" Margin="0,12,0,0"
                Background="{StaticResource WoodOakDarkBrush}" BorderBrush="#321708" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Style="{DynamicResource SettingsSecondaryButtonStyle}"
                    Content="{localization:Loc RoofGeometryWindow_Cancel}" />
            <Button x:Name="PreviewButton"
                    Margin="0,0,10,0"
                    Click="PreviewButton_Click"
                    IsEnabled="{Binding CanPreview}"
                    Style="{DynamicResource SettingsSecondaryButtonStyle}"
                    Content="{localization:Loc RoofGeometryWindow_Preview}" />
            <Button x:Name="ApplyButton"
                    Click="ApplyButton_Click"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    Style="{DynamicResource SettingsPrimaryButtonStyle}"
                    Content="{Binding PrimaryActionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
