<Window x:Class="AcKrovy.AutoCAD.UI.HipRoofPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
        Title="{Binding WindowTitle}"
        Width="520"
        MinWidth="460"
        MinHeight="300"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--
              Explicit numeric-field template matching the proven Settings TextBox metrics.
              The default TextBox ScrollViewer host clips glyphs when a Star-sized parent
              compresses ActualHeight below MinHeight+padding; this template keeps a fixed
              control height and centers the content host.
            -->
            <Style x:Key="HipSlopeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="MinHeight" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="MaxHeight" Value="{DynamicResource SettingsControlHeight}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontFamily" Value="{DynamicResource SettingsFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource SettingsFontSizeBody}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource SettingsCornerRadiusSmall}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="{DynamicResource SettingsDisabledOpacity}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsFocusBrush}" />
                                </Trigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsValidationBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="{Binding WindowTitle}" />
            <TextBlock Margin="0,4,0,14"
                       Style="{DynamicResource SettingsDescriptionStyle}"
                       Text="{Binding WindowDescription}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                Style="{DynamicResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Margin="0,0,0,10"
                           Style="{DynamicResource SettingsSectionTitleStyle}"
                           Text="{localization:Loc RoofGeometryWindow_EnteredValues}" />
                <TextBlock Margin="0,0,0,5"
                           Text="{localization:Loc RoofGeometryWindow_MonopitchSlope}" />
                <TextBox x:Name="SlopeTextBox"
                         Style="{StaticResource HipSlopeTextBoxStyle}"
                         Text="{Binding SlopeText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   MinHeight="20"
                   Foreground="{DynamicResource SettingsValidationBrush}"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Style="{DynamicResource SettingsSecondaryButtonStyle}"
                    Content="{localization:Loc RoofGeometryWindow_Cancel}" />
            <Button x:Name="PreviewButton"
                    Margin="0,0,10,0"
                    Click="PreviewButton_Click"
                    IsEnabled="{Binding CanPreview}"
                    Style="{DynamicResource SettingsSecondaryButtonStyle}"
                    Content="{localization:Loc RoofGeometryWindow_Preview}" />
            <Button x:Name="ApplyButton"
                    Click="ApplyButton_Click"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    Style="{DynamicResource SettingsPrimaryButtonStyle}"
                    Content="{Binding PrimaryActionText}" />
        </StackPanel>
    </Grid>
</Window>
