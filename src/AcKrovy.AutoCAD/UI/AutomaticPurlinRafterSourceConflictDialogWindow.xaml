<Window x:Class="AcKrovy.AutoCAD.UI.AutomaticPurlinRafterSourceConflictDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        Height="340"
        MinWidth="420"
        MinHeight="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WoodOakBrush}"
        Foreground="{DynamicResource SettingsTextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
                <ResourceDictionary Source="Design/RoofGeometryVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsPrimaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsBaseButtonStyle}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource RoofGeometryPrimaryButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RoofGeometryPrimaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SettingsSecondaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsBaseButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource RoofGeometrySecondaryButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RoofGeometrySecondaryButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            Padding="14"
            Background="{DynamicResource SettingsPanelBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Margin="0,0,10,0"
                            MinWidth="96"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource SettingsSecondaryButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="KeepManualButton"
                            Margin="0,0,10,0"
                            MinWidth="160"
                            Click="KeepManualButton_Click"
                            Style="{StaticResource SettingsSecondaryButtonStyle}" />
                    <Button x:Name="UseActualButton"
                            MinWidth="160"
                            IsDefault="True"
                            Click="UseActualButton_Click"
                            Style="{StaticResource SettingsPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="DescriptionText"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Style="{DynamicResource SettingsDescriptionStyle}" />
                <Border Margin="0,0,0,8"
                        Padding="10,8"
                        Background="{DynamicResource SettingsPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="ManualCaptionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="ManualProfileText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="10,8"
                        Background="{DynamicResource SettingsPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="ActualCaptionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="ActualProfileText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
