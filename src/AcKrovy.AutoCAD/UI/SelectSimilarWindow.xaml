<Window x:Class="AcKrovy.AutoCAD.UI.SelectSimilarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
        Title="{localization:Loc SelectSimilarWindow_Title}"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18"
            Style="{DynamicResource SettingsCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                       Text="{localization:Loc SelectSimilarWindow_Heading}" />
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,14"
                       Style="{DynamicResource SettingsDescriptionStyle}"
                       Text="{localization:Loc SelectSimilarWindow_Description}" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox x:Name="ElementTypeCheckBox"
                              Margin="0,4"
                              Content="{localization:Loc SelectSimilarWindow_ElementType}" />
                    <CheckBox x:Name="CrossSectionCheckBox"
                              Margin="0,4"
                              Content="{localization:Loc SelectSimilarWindow_CrossSection}" />
                    <CheckBox x:Name="MaterialCheckBox"
                              Margin="0,4"
                              Content="{localization:Loc SelectSimilarWindow_Material}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="ElementIdCheckBox"
                              Margin="0,4"
                              Content="{localization:Loc SelectSimilarWindow_ElementId}" />
                    <CheckBox x:Name="CuttingLengthCheckBox"
                              Margin="0,4"
                              Checked="CuttingLengthCheckBox_Changed"
                              Unchecked="CuttingLengthCheckBox_Changed"
                              Content="{localization:Loc SelectSimilarWindow_CuttingLength}" />
                    <CheckBox x:Name="CustomDefinitionCheckBox"
                              Margin="0,4"
                              Content="{localization:Loc SelectSimilarWindow_CustomDefinition}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="{localization:Loc SelectSimilarWindow_ToleranceMm}" />
                    <TextBox x:Name="ToleranceTextBox"
                             Grid.Column="1"
                             Text="1" />
                </Grid>
                <TextBlock x:Name="ValidationText"
                           Grid.Row="1"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource SettingsValidationBrush}"
                           Text="{localization:Loc SelectSimilarWindow_InvalidTolerance}"
                           Visibility="Collapsed" />
                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button MinWidth="100"
                            Margin="0,0,8,0"
                            Style="{DynamicResource SettingsSecondaryButtonStyle}"
                            IsCancel="True"
                            Click="Cancel_Click"
                            Content="{localization:Loc Common_Cancel}" />
                    <Button MinWidth="100"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            IsDefault="True"
                            Click="Confirm_Click"
                            Content="{localization:Loc SelectSimilarWindow_Select}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
