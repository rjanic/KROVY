<Window x:Class="AcKrovy.AutoCAD.UI.LayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcKrovy.AutoCAD.UI"
        xmlns:localization="clr-namespace:AcKrovy.AutoCAD.UI.Localization"
        xmlns:settings="clr-namespace:AcKrovy.Localization;assembly=AcKrovy.Localization"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{localization:Loc SettingsWindow_Title}"
        Width="1500"
        Height="900"
        MinWidth="1250"
        MinHeight="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextPrimaryBrush}"
        FontFamily="{DynamicResource SettingsFontFamily}"
        FontSize="{DynamicResource SettingsFontSizeBody}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsColors.Light.xaml" />
                <ResourceDictionary Source="Design/SettingsDesignSystem.xaml" />
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHostStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="LayersSectionHostStyle" TargetType="Border" BasedOn="{StaticResource SectionHostStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedSection}" Value="{x:Static settings:SettingsWindowTabKind.Layers}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ManufacturingSectionHostStyle" TargetType="Border" BasedOn="{StaticResource SectionHostStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedSection}" Value="{x:Static settings:SettingsWindowTabKind.Manufacturing}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AnnotationSectionHostStyle" TargetType="Border" BasedOn="{StaticResource SectionHostStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedSection}" Value="{x:Static settings:SettingsWindowTabKind.Annotation}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LanguageSectionHostStyle" TargetType="Border" BasedOn="{StaticResource SectionHostStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedSection}" Value="{x:Static settings:SettingsWindowTabKind.Language}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LightThemeChoiceButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedTheme}" Value="{x:Static settings:SettingsTheme.Light}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="{DynamicResource SettingsAccentBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SettingsFocusBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DarkThemeChoiceButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visual.SelectedTheme}" Value="{x:Static settings:SettingsTheme.Dark}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="{DynamicResource SettingsAccentBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SettingsFocusBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource SettingsNavigationColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource SettingsSidebarBackgroundBrush}">
            <Grid Margin="0,24,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,0">
                    <TextBlock Foreground="{DynamicResource SettingsSidebarTextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="ACAD KROVY" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SettingsSidebarMutedTextBrush}"
                               FontSize="{DynamicResource SettingsFontSizeCaption}"
                               Text="{Binding Visual.ApplicationVersionLabel}" />
                </StackPanel>

                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="2"
                         ItemsSource="{Binding Visual.NavigationItems}"
                         SelectedValuePath="Section"
                         SelectedValue="{Binding Visual.SelectedSection, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                         automation:AutomationProperties.Name="{localization:Loc SettingsWindow_Accessibility_Navigation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource SettingsSidebarTextBrush}"
                                      StrokeThickness="1.6">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{DynamicResource SettingsIconLayers}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Static settings:SettingsWindowTabKind.Manufacturing}">
                                                    <Setter Property="Data" Value="{DynamicResource SettingsIconManufacturing}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Static settings:SettingsWindowTabKind.Annotation}">
                                                    <Setter Property="Data" Value="{DynamicResource SettingsIconAnnotation}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Static settings:SettingsWindowTabKind.Language}">
                                                    <Setter Property="Data" Value="{DynamicResource SettingsIconLanguage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SettingsSidebarTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding DisplayName}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="20,0">
                    <TextBlock Margin="4,0,0,6"
                               Foreground="{DynamicResource SettingsSidebarMutedTextBrush}"
                               FontSize="{DynamicResource SettingsFontSizeCaption}"
                               Text="{localization:Loc SettingsWindow_Theme}" />
                    <Button x:Name="LightThemeButton"
                            Margin="0,0,0,6"
                            Style="{StaticResource LightThemeChoiceButtonStyle}"
                            Click="LightTheme_Click"
                            automation:AutomationProperties.Name="{localization:Loc SettingsWindow_ThemeLight}">
                        <TextBlock Text="{localization:Loc SettingsWindow_ThemeLight}"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button x:Name="DarkThemeButton"
                            Style="{StaticResource DarkThemeChoiceButtonStyle}"
                            Click="DarkTheme_Click"
                            automation:AutomationProperties.Name="{localization:Loc SettingsWindow_ThemeDark}">
                        <TextBlock Text="{localization:Loc SettingsWindow_ThemeDark}"
                                   TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource SettingsFontSizeTitle}"
                               FontWeight="{DynamicResource SettingsFontWeightSemiBold}"
                               TextWrapping="Wrap"
                               Text="{localization:Loc SettingsWindow_Heading}" />
                    <TextBlock Margin="0,5,24,0"
                               MaxWidth="820"
                               HorizontalAlignment="Left"
                               Style="{DynamicResource SettingsDescriptionStyle}"
                               Text="{localization:Loc SettingsWindow_Description}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SettingsSelectedBrush}"
                        BorderBrush="{DynamicResource SettingsAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SettingsCornerRadiusSmall}">
                    <TextBlock Foreground="{DynamicResource SettingsAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding Visual.FormStateText}" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="{DynamicResource SettingsSectionMargin}">
                <Border Style="{StaticResource LayersSectionHostStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                                       Text="{localization:Loc SettingsWindow_Layers_Tab}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{DynamicResource SettingsDescriptionStyle}"
                                       Text="{localization:Loc SettingsWindow_Layers_Description}" />
                        </StackPanel>
                        <DataGrid x:Name="StylesDataGrid"
                                  Grid.Row="2"
                                  Style="{DynamicResource SettingsDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{localization:Loc SettingsWindow_Layers_ElementTypeColumn}"
                                                    Binding="{Binding ElementLabel}"
                                                    IsReadOnly="True"
                                                    Width="120" />
                                <DataGridTemplateColumn Header="{localization:Loc SettingsWindow_Layers_LayerNameColumn}"
                                                        Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True"
                                                      SelectionChanged="LayerNameComboBox_SelectionChanged"
                                                      LostKeyboardFocus="LayerNameComboBox_LostKeyboardFocus"
                                                      ItemsSource="{Binding DataContext.LayerNameOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      Text="{Binding LayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      automation:AutomationProperties.Name="{localization:Loc SettingsWindow_Layers_LayerNamePrompt}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{localization:Loc SettingsWindow_Layers_LayerColorColumn}"
                                                        Width="142">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:AciColorPicker Margin="4,2"
                                                                  Options="{Binding DataContext.ColorOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                  SelectedAciIndex="{Binding AciColorIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{localization:Loc SettingsWindow_Layers_LinetypeColumn}"
                                                        Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedLinetypeName}"
                                                       Text="{Binding SelectedLinetypeName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.LinetypeOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SelectedItem="{Binding SelectedLinetypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{localization:Loc SettingsWindow_Layers_LinetypeScaleColumn}"
                                                    Binding="{Binding LinetypeScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="118" />
                                <DataGridTemplateColumn Header="{localization:Loc SettingsWindow_Layers_PreviewColumn}"
                                                        IsReadOnly="True"
                                                        Width="142">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,0"
                                                  ToolTip="{Binding PreviewToolTip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Line X1="0"
                                                      X2="105"
                                                      Y1="10"
                                                      Y2="10"
                                                      Stroke="{Binding SelectedColor.Brush}"
                                                      StrokeThickness="3">
                                                    <Line.Style>
                                                        <Style TargetType="Line">
                                                            <Setter Property="StrokeDashArray" Value="" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedLinetypeName}" Value="DASHDOT">
                                                                    <Setter Property="StrokeDashArray" Value="7,3,1,3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Line.Style>
                                                </Line>
                                                <TextBlock Grid.Row="1"
                                                           FontSize="{DynamicResource SettingsFontSizeCaption}"
                                                           Foreground="{DynamicResource SettingsTextSecondaryBrush}"
                                                           Text="{Binding LinetypeScaleText, StringFormat=× {0}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ManufacturingSectionHostStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                                       Text="{localization:Loc SettingsWindow_Manufacturing_Tab}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{DynamicResource SettingsDescriptionStyle}"
                                       Text="{localization:Loc SettingsWindow_Manufacturing_Description}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{localization:Loc SettingsWindow_Manufacturing_RoundingStep}" />
                            <TextBox Width="110"
                                     Margin="14,0,8,0"
                                     Text="{Binding RoundingStepMmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="{localization:Loc SettingsWindow_Manufacturing_RoundingStep}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SettingsTextSecondaryBrush}"
                                       Text="{localization:Loc SettingsWindow_UnitMillimetres}" />
                        </StackPanel>
                        <DataGrid x:Name="DefaultsDataGrid"
                                  Grid.Row="4"
                                  Style="{DynamicResource SettingsDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{localization:Loc SettingsWindow_Manufacturing_ElementTypeColumn}"
                                                    Binding="{Binding ElementLabel}"
                                                    IsReadOnly="True"
                                                    Width="260" />
                                <DataGridTextColumn Header="{localization:Loc SettingsWindow_Manufacturing_DefaultAllowanceColumn}"
                                                    Binding="{Binding CuttingAllowanceMmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{localization:Loc SettingsWindow_UnitMillimetres}"
                                                    Binding="{Binding UnitLabel}"
                                                    IsReadOnly="True"
                                                    Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AnnotationSectionHostStyle}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                                       Text="{localization:Loc SettingsWindow_Annotation_Tab}" />
                            <TextBlock Margin="0,4,0,18"
                                       Style="{DynamicResource SettingsDescriptionStyle}"
                                       Text="{localization:Loc SettingsWindow_Annotation_Description}" />

                            <ListBox x:Name="AnnotationPresetSelector"
                                     ItemsSource="{Binding AnnotationPresetOptions}"
                                     SelectedValuePath="Preset"
                                     SelectedValue="{Binding SelectedAnnotationPreset, Mode=TwoWay}"
                                     PreviewKeyDown="AnnotationPresetSelector_PreviewKeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SettingsSelectionCardItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="180"
                                              ToolTip="{Binding DisplayName}"
                                              AutomationProperties.Name="{Binding AccessibilityName}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="145" />
                                                <RowDefinition Height="35" />
                                            </Grid.RowDefinitions>
                                            <Border Margin="0,0,0,5"
                                                    Background="{DynamicResource SettingsAnnotationPreviewBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource SettingsCornerRadiusSmall}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding PreviewResourceUri}"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True"
                                                       UseLayoutRounding="True" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource SettingsFontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       MaxHeight="32"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DisplayName}" />
                                            <Path Grid.RowSpan="2"
                                                  Width="13"
                                                  Height="13"
                                                  Margin="0,4,4,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Data="{DynamicResource SettingsIconCheck}"
                                                  Stroke="{DynamicResource SettingsAccentBrush}"
                                                  StrokeThickness="2"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,18,0,0"
                                    Style="{DynamicResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                                               Text="{localization:Loc SettingsWindow_AnnotationScale_Title}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Padding="16"
                                                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource SettingsCornerRadius}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{localization:Loc SettingsWindow_AnnotationScale_CurrentDrawing}" />
                                                <TextBlock Margin="0,3,0,10"
                                                           Style="{DynamicResource SettingsDescriptionStyle}"
                                                           Text="{Binding DrawingScaleSourceText}" />
                                                <ComboBox x:Name="DrawingAnnotationScaleSelector"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding AnnotationScaleOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Preset"
                                                          SelectedValue="{Binding SelectedDrawingScalePreset, Mode=TwoWay}" />
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsDrawingCustomScale, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{localization:Loc SettingsWindow_AnnotationScale_Denominator}" />
                                                    <DockPanel Margin="0,4,0,0">
                                                        <TextBlock Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="1 :" />
                                                        <TextBox x:Name="DrawingCustomScaleTextBox"
                                                                 MaxLength="3"
                                                                 Text="{Binding DrawingCustomScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{DynamicResource SettingsValidationBrush}"
                                                               Text="{Binding ScaleValidationText}"
                                                               Visibility="{Binding HasDrawingScaleError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Margin="0,12,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{DynamicResource SettingsSecondaryButtonStyle}"
                                                        Click="UseDefaultAnnotationScale_Click"
                                                        Content="{localization:Loc SettingsWindow_AnnotationScale_UseDefault}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Padding="16"
                                                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource SettingsCornerRadius}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{localization:Loc SettingsWindow_AnnotationScale_UserDefault}" />
                                                <TextBlock Margin="0,3,0,10"
                                                           Style="{DynamicResource SettingsDescriptionStyle}"
                                                           Text="{localization:Loc SettingsWindow_AnnotationScale_UserDefaultHelp}" />
                                                <ComboBox x:Name="UserDefaultAnnotationScaleSelector"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding AnnotationScaleOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Preset"
                                                          SelectedValue="{Binding SelectedUserDefaultScalePreset, Mode=TwoWay}" />
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsUserDefaultCustomScale, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{localization:Loc SettingsWindow_AnnotationScale_Denominator}" />
                                                    <DockPanel Margin="0,4,0,0">
                                                        <TextBlock Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="1 :" />
                                                        <TextBox x:Name="UserDefaultCustomScaleTextBox"
                                                                 MaxLength="3"
                                                                 Text="{Binding UserDefaultCustomScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{DynamicResource SettingsValidationBrush}"
                                                               Text="{Binding ScaleValidationText}"
                                                               Visibility="{Binding HasUserDefaultScaleError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Margin="0,14,0,0"
                                            Padding="14"
                                            Background="{DynamicResource SettingsPanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource SettingsBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource SettingsCornerRadius}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{localization:Loc SettingsWindow_AnnotationScale_Preview}" />
                                            <UniformGrid Margin="0,10,0,0" Columns="4">
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource SettingsDescriptionStyle}"
                                                               Text="{localization:Loc SettingsWindow_AnnotationScale_DimensionHeight}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PreviewDimensionText}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource SettingsDescriptionStyle}"
                                                               Text="{localization:Loc SettingsWindow_AnnotationScale_ItemHeight}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PreviewItemNumberText}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource SettingsDescriptionStyle}"
                                                               Text="{localization:Loc SettingsWindow_AnnotationScale_SlopeHeight}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PreviewSlopeText}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource SettingsDescriptionStyle}"
                                                               Text="{localization:Loc SettingsWindow_AnnotationScale_BlockScale}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PreviewBlockScale}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Style="{StaticResource LanguageSectionHostStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SettingsSectionTitleStyle}"
                                       Text="{localization:Loc SettingsWindow_Language_Tab}" />
                            <TextBlock Margin="0,4,0,18"
                                       Style="{DynamicResource SettingsDescriptionStyle}"
                                       Text="{localization:Loc SettingsWindow_Language_Description}" />
                            <ListBox x:Name="LanguageSelector"
                                     ItemsSource="{Binding LanguageOptions}"
                                     SelectedValuePath="Code"
                                     SelectedValue="{Binding SelectedLanguageCode, Mode=OneWay}"
                                     SelectionChanged="LanguageSelector_SelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SettingsLanguageCardItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="3" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="220"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ClipToBounds="True"
                                              AutomationProperties.Name="{Binding AccessibilityName}">
                                            <Border HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{DynamicResource SettingsFlagCardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource SettingsCornerRadiusSmall}"
                                                    ClipToBounds="True"
                                                    IsHitTestVisible="False">
                                                <Image HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       Stretch="Fill"
                                                       SnapsToDevicePixels="True"
                                                       UseLayoutRounding="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="{Binding BlackFlagUri}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                             Value="True">
                                                                    <Setter Property="Source" Value="{Binding ColorFlagUri}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>
                                            <Border Width="38"
                                                    Height="28"
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Panel.ZIndex="2"
                                                    Background="{DynamicResource SettingsBadgeBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SettingsAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource SettingsCornerRadiusSmall}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SettingsBadgeTextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding UpperCode}" />
                                            </Border>
                                            <Path Width="14"
                                                  Height="14"
                                                  Margin="10"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Panel.ZIndex="3"
                                                  Data="{DynamicResource SettingsIconCheck}"
                                                  Stroke="{DynamicResource SettingsAccentBrush}"
                                                  StrokeThickness="2"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1"
                Grid.Row="1"
                Padding="24,14"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreDefaultsButton"
                        Style="{DynamicResource SettingsSecondaryButtonStyle}"
                        Click="RestoreDefaults_Click"
                        Content="{localization:Loc SettingsWindow_RestoreDefaults}" />

                <StackPanel x:Name="LayersFooterActions"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Orientation="Horizontal">
                    <Button x:Name="LayersApplyButton"
                            Margin="0,0,10,0"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            Click="Apply_Click"
                            Content="{localization:Loc SettingsWindow_Apply}" />
                    <Button Style="{DynamicResource SettingsSecondaryButtonStyle}"
                            Click="Close_Click"
                            IsCancel="True"
                            Content="{localization:Loc SettingsWindow_Close}" />
                </StackPanel>

                <StackPanel x:Name="ManufacturingFooterActions"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Orientation="Horizontal">
                    <Button x:Name="ManufacturingApplyButton"
                            Margin="0,0,10,0"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            Click="Apply_Click"
                            Content="{localization:Loc SettingsWindow_Apply}" />
                    <Button Style="{DynamicResource SettingsSecondaryButtonStyle}"
                            Click="Close_Click"
                            IsCancel="True"
                            Content="{localization:Loc SettingsWindow_Close}" />
                </StackPanel>

                <StackPanel x:Name="AnnotationFooterActions"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Orientation="Horizontal">
                    <Button x:Name="SaveNewElementsButton"
                            Margin="0,0,10,0"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            Click="SaveNewElements_Click">
                        <TextBlock Text="{localization:Loc SettingsWindow_SaveNewElementsOnly}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button x:Name="SaveApplySelectionButton"
                            Margin="0,0,10,0"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            Click="SaveApplySelection_Click">
                        <TextBlock Text="{localization:Loc SettingsWindow_SaveApplySelection}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button x:Name="SaveApplyAllButton"
                            Margin="0,0,10,0"
                            Style="{DynamicResource SettingsPrimaryButtonStyle}"
                            Click="SaveApplyAll_Click">
                        <TextBlock Text="{localization:Loc SettingsWindow_SaveApplyAll}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button Style="{DynamicResource SettingsSecondaryButtonStyle}"
                            Click="Close_Click"
                            IsCancel="True"
                            Content="{localization:Loc SettingsWindow_Close}" />
                </StackPanel>

                <StackPanel x:Name="LanguageFooterActions"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Orientation="Horizontal">
                    <Button Style="{DynamicResource SettingsSecondaryButtonStyle}"
                            Click="Close_Click"
                            IsCancel="True"
                            Content="{localization:Loc SettingsWindow_Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="StatusBanner"
                Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                MaxWidth="860"
                Margin="44"
                Padding="26,19"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SettingsSuccessBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsSuccessBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SettingsCornerRadiusLarge}"
                Effect="{DynamicResource SettingsCardElevation}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                automation:AutomationProperties.LiveSetting="Polite">
            <TextBlock x:Name="StatusBannerText"
                       FontSize="19"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
